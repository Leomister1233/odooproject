# Copy to .env.production on the server. Never commit the real file.
WEB_IMAGE=ghcr.io/your-org/your-repository:sha-replace-me
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=accounting_portal
POSTGRES_USER=accounting_portal
POSTGRES_PASSWORD=replace-with-the-existing-application-database-password
ODOO_HOST=host.docker.internal
ODOO_PORT=8069

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-stable-fernet-key
DJANGO_ALLOWED_HOSTS=portal.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-brevo-smtp-login
EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Accounting Portal <no-reply@example.com>
PASSWORD_RESET_TIMEOUT=3600

AGT_ENVIRONMENT=homologation
AGT_BASE_URL=https://sifphml.minfin.gov.ao/sigt/fe/v1
AGT_USERNAME=
AGT_PASSWORD=
AGT_SCHEMA_VERSION=2.0
AGT_PRODUCT_ID=
AGT_PRODUCT_VERSION=
AGT_SOFTWARE_VALIDATION_NUMBER=
AGT_PRODUCER_KEY_REFERENCE=
AGT_CONNECT_TIMEOUT_SECONDS=10
AGT_READ_TIMEOUT_SECONDS=30
AGT_SUBMISSIONS_ENABLED=false
AGT_ALLOW_PRODUCTION=false
